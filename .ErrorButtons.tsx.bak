import { useState } from 'react'
import { useRecoveryStore } from '../core/RecoveryStore'
import { useSnapshotStore } from '../core/SnapshotManager'

interface ErrorScenario {
  id: string
  name: string
  description: string
  severity: 'critical' | 'moderate' | 'minor'
}

const ErrorButtons = () => {
  const [isTriggering, setIsTriggering] = useState<string | null>(null)
  const { isRecovering, recoveryCount } = useRecoveryStore()
  const { addRecoveryLog } = useSnapshotStore()

  const scenarios: ErrorScenario[] = [
    {
      id: 'runtime-error',
      name: 'Runtime Error',
      description: 'Throws an uncaught JavaScript error',
      severity: 'critical'
    },
    {
      id: 'crash',
      name: 'Component Crash',
      description: 'Simulates a React component failure',
      severity: 'critical'
    },
    {
      id: 'slow-render',
      name: 'Slow Render',
      description: 'Simulates performance degradation (LCP warning)',
      severity: 'moderate'
    },
    {
      id: 'network',
      name: 'Network Failure',
      description: 'Simulates failed API request',
      severity: 'moderate'
    },
    {
      id: 'memory',
      name: 'Memory Leak',
      description: 'Simulates out-of-memory scenario',
      severity: 'critical'
    }
  ]

  const triggerError = (scenarioId: string) => {
    setIsTriggering(scenarioId)

    switch (scenarioId) {
      case 'runtime-error':
        addRecoveryLog({
          type: 'error',
          message: '⚠️ RUNTIME ERROR DETECTED: Uncaught TypeError'
        })
        setTimeout(() => {
          throw new Error('Simulated runtime error - this would crash the app!')
        }, 100)
        break

      case 'crash':
        addRecoveryLog({
          type: 'error',
          message: '💥 COMPONENT CRASH: React component failed to render'
        })
        setTimeout(() => {
          const crashTarget: any = undefined
          crashTarget.trigger()
        }, 100)
        break

      case 'slow-render':
        addRecoveryLog({
          type: 'error',
          message: '🐌 PERFORMANCE ALERT: Slow render detected (LCP degradation)'
        })
        setTimeout(() => {
          addRecoveryLog({
            type: 'success',
            message: 'Performance auto-optimizing...'
          })
        }, 2000)
        break

      case 'network':
        addRecoveryLog({
          type: 'error',
          message: '🔌 NETWORK ERROR: API request failed (504 Gateway Timeout)'
        })
        setTimeout(() => {
          addRecoveryLog({
            type: 'recovery',
            message: 'Retrying request with backoff...'
          })
        }, 1500)
        break

      case 'memory':
        addRecoveryLog({
          type: 'error',
          message: 'MemoryWarning: Tab approaching memory limit'
        })
        setTimeout(() => {
          addRecoveryLog({
            type: 'success',
            message: 'Garbage collection triggered, memory freed'
          })
        }, 2500)
        break

      default:
        break
    }

    setTimeout(() => setIsTriggering(null), 3000)
  }

  const handleRecoverAll = () => {
    addRecoveryLog({
      type: 'recovery',
      message: '🔄 Initiating full system recovery...'
    })
    const { incrementRecoveryCount, setIsRecovering } = useRecoveryStore.getState()
    incrementRecoveryCount()
    setIsRecovering(true)
    setTimeout(() => {
      setIsRecovering(false)
      addRecoveryLog({
        type: 'success',
        message: '✅ ALL SYSTEMS RESTORED'
      })
    }, 1000)
  }

  return (
    <section className="dashboard-card error-simulator" aria-labelledby="scenario-heading">
      <div className="component-heading">
        <div className="component-heading-copy">
          <span className="component-icon component-icon-amber" aria-hidden="true">!</span>
          <div>
            <h3 id="scenario-heading">Test a recovery scenario</h3>
            <p>Trigger a demo signal and watch the session activity.</p>
          </div>
        </div>
        <span className="component-tag">5 SCENARIOS</span>
      </div>

      <div className="error-scenario-list">
        {scenarios.map((scenario, index) => (
          <button
            key={scenario.id}
            onClick={() => triggerError(scenario.id)}
            disabled={isTriggering === scenario.id || isRecovering}
            className={`error-scenario ${scenario.severity === 'critical' ? 'error-scenario-critical' : 'error-scenario-moderate'}`}
          >
            <span className="error-scenario-number">0{index + 1}</span>
            <span className="error-scenario-copy">
              <strong>{isTriggering === scenario.id ? 'Triggering…' : scenario.name}</strong>
              <span>{scenario.description}</span>
            </span>
            <span className="error-scenario-arrow" aria-hidden="true">↗</span>
          </button>
        ))}
      </div>

      <div className="recovery-controls">
        <button
          onClick={handleRecoverAll}
          disabled={isRecovering}
          className="action-primary recovery-all-button"
        >
          <span aria-hidden="true">↺</span>{isRecovering ? 'Recovering…' : 'Recover all'}
        </button>
        <div className="recovery-controls-meta">
          <span>Recovery #{recoveryCount}</span>
          <span className="recovery-state"><span />{isRecovering ? 'In progress' : 'Ready'}</span>
        </div>
      </div>
    </section>
  )
}

export { ErrorButtons }
