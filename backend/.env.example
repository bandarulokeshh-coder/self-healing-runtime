# Environment variables for Self-Healing Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
FRONTEND_URL=http://localhost:5173

# Database (SQLite for simplicity - change to PostgreSQL for production)
DATABASE_URL=sqlite:///./selfhealing.db

# Redis (optional - for caching/queuing)
REDIS_URL=redis://localhost:6379

# LLM API Keys (set these in your environment - do NOT commit real keys)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
